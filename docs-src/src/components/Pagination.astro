---
// Previous / next links. Same markup and labels as Starlight's own; the glyphs are the site's Lucide arrows
// (arrow-left / arrow-right, currentColor, 2.25 stroke) instead of Starlight's built-in icons.
const { dir, pagination } = Astro.locals.starlightRoute;
const { prev, next } = pagination;
const isRtl = dir === 'rtl';
const L = '<path d="m12 19-7-7 7-7" /><path d="M19 12H5" />';
const R = '<path d="M5 12h14" /><path d="m12 5 7 7-7 7" />';
---
<div class="pagination-links print:hidden" dir={dir}>
	{prev && (
		<a href={prev.href} rel="prev">
			<svg class="arr" viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={isRtl ? R : L} />
			<span>
				{Astro.locals.t('page.previousLink')}
				<br />
				<span class="link-title">{prev.label}</span>
			</span>
		</a>
	)}
	{next && (
		<a href={next.href} rel="next">
			<svg class="arr" viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={isRtl ? L : R} />
			<span>
				{Astro.locals.t('page.nextLink')}
				<br />
				<span class="link-title">{next.label}</span>
			</span>
		</a>
	)}
</div>

<style>
	@layer starlight.core {
		.pagination-links { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(18rem, 100%), 1fr)); gap: 1rem; }
		a { display: flex; align-items: center; justify-content: flex-start; gap: 0.75rem; width: 100%; padding: 1rem 1.125rem; border: 1px solid var(--sl-color-gray-5); border-radius: 4px; background: #fff; color: var(--sl-color-gray-3); text-decoration: none; font-size: var(--sl-text-sm); line-height: 1.4; overflow-wrap: anywhere; transition: border-color 0.2s; }
		a:hover { border-color: var(--sl-color-white); }
		[rel='next'] { flex-direction: row-reverse; justify-content: space-between; text-align: end; }
		[rel='next'] .arr { margin-inline-start: auto; }
		.link-title { color: var(--sl-color-white); font-family: 'Saira', 'Inter', sans-serif; font-stretch: 112%; font-weight: 620; font-size: var(--sl-text-lg); line-height: 1.25; }
		.arr { flex: none; width: 1.375rem; height: 1.375rem; fill: none; stroke: currentColor; stroke-width: 2.25; stroke-linecap: round; stroke-linejoin: round; color: var(--sl-color-white); }
	}
</style>
