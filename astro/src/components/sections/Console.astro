---
import type { Locale } from '../../i18n/ui';
import type { Content } from '../../data/content';
import { site } from '../../data/site';
interface Props { c: Content; locale: Locale; }
const { c, locale } = Astro.props;
const s = site[locale];
const k = c.console;
---
<section class="band dark" id="console" aria-labelledby="console-h">
  <div class="wrap">
    <div class="head">
      <div>
        <p class="index">{s.sections.console}</p>
        <h2 id="console-h">{k.title}</h2>
      </div>
      <p class="lead">{k.desc}</p>
    </div>
    <div class="panel reveal">
      <div class="panel__bar">
        <span class="mono panel__path">{k.path}</span>
        <span class="mono panel__badge">{k.badge}</span>
      </div>
      <dl class="stats">
        {k.stats.map((st) => (<div class="stat"><dt class="legend">{st.label}</dt><dd class="num">{st.value}</dd></div>))}
      </dl>
      <div class="tbl-wrap panel__tbl" tabindex="0" role="region" aria-label={k.path}>
        <table class="tbl tbl--mono">
          <thead><tr>{k.columns.map((col) => <th scope="col">{col}</th>)}</tr></thead>
          <tbody>
            {k.rows.map((r) => (
              <tr>
                <td>{r.id}</td><td>{r.version}</td><td>{r.bank}</td>
                <td><span class:list={['st', `st--${r.state}`]}><i aria-hidden="true"></i>{r.label}</span></td>
                <td>{r.seen}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
    <p class="caption">{k.foot}</p>
  </div>
</section>
<style>
  .panel { border: 1px solid var(--rule-dark); border-radius: var(--r-2); background: rgba(244, 244, 241, 0.02); }
  .panel__bar { display: flex; justify-content: space-between; gap: 16px; padding: 14px 18px; border-bottom: 1px solid var(--rule-dark); color: var(--mist); }
  .panel__badge { color: var(--paper); }
  .stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-bottom: 1px solid var(--rule-dark); }
  .stat { padding: 18px; }
  .stat + .stat { border-left: 1px solid var(--rule-dark); }
  .stat dt { color: var(--mist); font-size: 12px; }
  .stat dd { font-family: var(--f-display); font-stretch: 118%; font-weight: 620; font-size: 36px; line-height: 1.1; margin-top: 8px; }
  .panel__tbl { border: 0; border-radius: 0; }
  .st { display: inline-flex; align-items: center; gap: 8px; }
  .st i { width: 9px; height: 6.5px; border-radius: 50%; background: var(--mist); }
  .st--ok i { background: #3fbf7f; }
  .st--warn i { background: var(--amber); }
  .st--info i { background: transparent; border: 1px solid var(--mist); }
  @media (max-width: 760px) {
    .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .stat:nth-child(3) { border-left: 0; }
    .stat:nth-child(n + 3) { border-top: 1px solid var(--rule-dark); }
    .stat dd { font-size: 28px; }
    .panel__tbl .tbl { min-width: 560px; }
  }
</style>
