---
import ArrowText from '../ArrowText.astro';
// Buyer-trust strip above the final CTA: what evidence is available to buyers,
// shown as a spec plate, with a link to the Compliance page.
import { localizePath, type Locale } from '../../i18n/ui';
import { site } from '../../data/site';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = site[locale].trust2;
// Each item reads "key — value"; the layout replaces the dash.
const rows = t.items.map((it) => it.split(' — '));
---
<section class="band--tight wrap trust2" aria-labelledby="trust2-h">
  <p class="index" id="trust2-h"><span class="beacon beacon--sm" aria-hidden="true"></span>{t.eyebrow}</p>
  <div class="plate">
    <dl>
      {rows.map(([k, v]) => (<><dt>{k}</dt><dd>{v.charAt(0).toUpperCase() + v.slice(1)}</dd></>))}
    </dl>
  </div>
  <a class="link-arrow trust2__link" href={localizePath('/compliance', locale)}><ArrowText text={t.link} /></a>
</section>
<style>
  .trust2 { display: grid; gap: 20px; }
  .trust2 .plate dl { grid-template-columns: minmax(max-content, 22rem) 1fr; }
  .trust2__link { justify-self: start; }
  @media (max-width: 860px) {
    /* Repeated here: .trust2 .plate dl out-ranks the global .plate rule. Label above value, one rule per row. */
    .trust2 .plate dl { grid-template-columns: minmax(0, 1fr); }
    .trust2 .plate dt { padding-bottom: 2px; }
    .trust2 .plate dd { border-top: 0; padding-top: 2px; }
  }
</style>
