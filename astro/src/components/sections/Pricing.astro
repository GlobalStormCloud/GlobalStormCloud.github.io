---
import Arrow from '../Arrow.astro';
import InlineCta from './InlineCta.astro';
import { localizePath, type Locale } from '../../i18n/ui';
import type { Content } from '../../data/content';
import { site } from '../../data/site';
import { parseEur, fmtEur } from '../../data/pricing-format';
interface Props { c: Content; locale: Locale; }
const { c, locale } = Astro.props;
const s = site[locale].pricing;
const p = c.pricing;
const [sup, cus] = p.profiles;
const contact = localizePath('/company', locale) + '#contact';

// Worked example: Supported, 250 devices, own telemetry = 50 × Launch + 200 × Production.
const launch = parseEur(sup.rows[0].own);
const production = parseEur(sup.rows[1].own);
const lines: [string, string][] = [
  [`50 × ${sup.rows[0].own}`, fmtEur(50 * launch, locale)],
  [`200 × ${sup.rows[1].own}`, fmtEur(200 * production, locale)],
];
const total = 50 * launch + 200 * production;
const published = parseEur(p.examples[1].own); // "€375/mo"
if (Math.abs(total - published) > 0.001) throw new Error(`Worked example ${total} ≠ published ${published}`);
---
<div class="wrap pricing">
  <div class="formula" id="plans">
    <span class="legend formula__k">{s.formulaLabel}</span>
    <code class="formula__f">{s.formula[0]} <em>{s.formula[1]}</em> {s.formula[2]}</code>
  </div>

  <div class="cards">
    <article class="card pc">
      <h2 class="legend pc__name">{p.trialName}</h2>
      <p class="pc__price num">{p.trialPrice}</p>
      <p class="mono pc__unit">{p.trialUnit}</p>
      <p class="pc__d">{p.trialDesc}</p>
      <a class="btn btn--ghost" href={contact}>{s.trialCta}</a>
    </article>
    <article class="card pc">
      <h2 class="legend pc__name">{p.paidTrialName}</h2>
      <p class="pc__price num">{p.paidTrialPrice}</p>
      <p class="mono pc__unit">{p.paidTrialUnit}</p>
      {p.paidTrialLines.map((l) => <p class="pc__min pc__min--stack mono"><span>{l.label}</span><b>{l.value}</b></p>)}
      <p class="pc__d">{p.paidTrialDesc}</p>
      <a class="btn btn--ghost" href={contact}>{s.paidTrialCta}</a>
    </article>
    <article class="card pc pc--feat">
      <p class="pc__flag mono"><span class="beacon beacon--ink" aria-hidden="true"></span>{s.featured}</p>
      <h2 class="legend pc__name">{sup.name}</h2>
      <p class="pc__price num"><span class="pc__from mono">{s.from}</span>{sup.rows[0].own}<small class="mono">{s.perDevice}</small></p>
      <p class="mono pc__unit">{s.launchNoTel}</p>
      <p class="pc__min mono"><span>{sup.minLabel}</span><b>{sup.minValue}</b></p>
      <p class="pc__d">{sup.note}</p>
      <a class="btn btn--primary" href={contact}>{s.supportedCta}<Arrow /></a>
    </article>
    <article class="card pc">
      <h2 class="legend pc__name">{cus.name}</h2>
      <p class="pc__price num"><span class="pc__from mono">{s.from}</span>{cus.rows[0].own}<small class="mono">{s.perDevice}</small></p>
      <p class="mono pc__unit">{s.launchNoTel}</p>
      <p class="pc__min mono"><span>{cus.minLabel}</span><b>{cus.minValue}</b></p>
      <p class="pc__d">{cus.note} {s.bringupLabel}: {p.bringup[0].price}.</p>
      <a class="btn btn--ghost" href={contact}>{s.customCta}</a>
    </article>
  </div>

  <section class="tiers" id="rates" aria-labelledby="tiers-h">
    <div class="tiers__head">
      <h2 id="tiers-h" class="h3">{p.tiersTitle}</h2>
      <p class="muted">{p.tiersNote}</p>
    </div>
    <div class="tiers__grid">
      {p.profiles.map((pr) => (
        <div class="tbl-wrap" tabindex="0" role="region" aria-label={pr.name}>
          <table class="tbl tbl--mono tbl--stack num">
            <caption><span class="legend">{pr.name}</span> <span class="mono muted">{s.table}</span></caption>
            <thead><tr><th scope="col">{p.colTier}</th><th scope="col">{p.colDevices}</th><th scope="col" class="r">{p.colOwn}</th><th scope="col" class="r">{p.colOurs}</th></tr></thead>
            <tbody>
              {pr.rows.map((r) => (<tr><td>{r.tier}</td><td data-label={p.colDevices}>{r.devices}</td><td class="r" data-label={p.colOwn}>{r.own}</td><td class="r" data-label={p.colOurs}>{r.ours}</td></tr>))}
            </tbody>
            <tfoot><tr><th scope="row" colspan="3">{pr.minLabel}</th><td class="r"><b>{pr.minValue}</b></td></tr></tfoot>
          </table>
        </div>
      ))}
    </div>
    <p class="muted tiers__note">{p.minimumNote}</p>
    <p class="mono tiers__callout">{p.calloutNote}</p>
  </section>

  <InlineCta c={c} locale={locale} />

  <section class="ex" id="examples" aria-labelledby="ex-h">
    <div class="plate ex__calc">
      <div class="plate__hdr"><h2 id="ex-h" class="legend">{s.exampleTitle}</h2></div>
      <div class="ex__body mono num">
        {lines.map(([a, b]) => <p class="ex__line"><span>{a}</span><span>{b}</span></p>)}
        <p class="ex__line ex__total"><span>{s.exampleTotalLabel}</span><span>{fmtEur(total, locale)} {s.perMonth}</span></p>
        <p class="ex__note">{s.exampleNote.replace('{min}', sup.minValue)}</p>
      </div>
    </div>
    <div class="ex__table">
      <h3 class="h3">{p.examplesTitle}</h3>
      <p class="muted ex__intro">{p.examplesNote}</p>
      <div class="tbl-wrap" tabindex="0" role="region" aria-label={p.examplesTitle}>
        <table class="tbl tbl--mono tbl--stack num">
          <thead><tr><th scope="col">{p.colProfile}</th><th scope="col" class="r">{p.colDevices}</th><th scope="col" class="r">{p.colOwn}</th><th scope="col" class="r">{p.colOurs}</th><th scope="col">{p.colBasis}</th></tr></thead>
          <tbody>{p.examples.map((e) => (<tr><td>{e.profile}</td><td class="r" data-label={p.colDevices}>{e.devices}</td><td class="r" data-label={p.colOwn}>{e.own}</td><td class="r" data-label={p.colOurs}>{e.ours}</td><td class="long" data-label={p.colBasis}>{e.basis}</td></tr>))}</tbody>
        </table>
      </div>
      <p class="caption">{p.examplesFoot}</p>
    </div>
  </section>

  <section class="extras" id="extras" aria-label={p.sameTitle}>
    <div class="plate">
      <div class="plate__hdr"><h2 class="legend">{p.bringupTitle}</h2></div>
      <dl>{p.bringup.map((b) => (<><dt>{b.label}</dt><dd>{b.price}</dd></>))}</dl>
      <p class="plate__foot muted">{p.bringupNote}</p>
    </div>
    <div class="plate">
      <div class="plate__hdr"><h2 class="legend">{p.sameTitle}</h2></div>
      <ul role="list" class="incl">{p.same.map((i) => <li>{i}</li>)}</ul>
    </div>
    <div class="plate">
      <div class="plate__hdr"><h2 class="legend">{p.addonsTitle}</h2></div>
      <dl>{p.addons.map((a) => (<><dt>{a.label}</dt><dd>{a.price}</dd></>))}</dl>
    </div>
  </section>

  <div class="terms">
    <p class="mono"><span class="terms__k legend">{locale === 'pl' ? 'Zobowiązania' : 'Commitments'}</span>{p.annualPrepay} · {p.volumeContact}</p>
    <p class="muted terms__fine">{p.fineprint}</p>
    <p class="mono terms__eu">{c.footer.euHosted} · {p.terms}</p>
  </div>
</div>

<style>
  .pricing { padding-bottom: var(--band-y); }
  .formula { display: flex; align-items: center; gap: 12px 24px; flex-wrap: wrap; padding: 16px 22px; border: 1px solid var(--alloy); border-radius: var(--r-2); background: var(--white); margin-bottom: 32px; }
  .formula__k { color: var(--steel); }
  .formula__f { font: 500 15px/1.5 var(--f-mono); }
  .formula__f em { font-style: normal; color: var(--amber-deep); }
  .cards { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1.15fr) minmax(0, 1fr); gap: 20px; align-items: stretch; margin-top: 44px; }
  .pc { position: relative; display: flex; flex-direction: column; }
  .pc .pc__min + .pc__min { margin-top: 0; padding-top: 10px; border-top: 0; }
  .pc__name { color: var(--steel); font-size: 12px; }
  .pc__price { font-family: var(--f-display); font-stretch: 118%; font-weight: 640; font-size: clamp(40px, 2rem + 1.2vw, 52px); line-height: 1; margin: 22px 0 8px; letter-spacing: -0.01em; display: flex; align-items: baseline; flex-wrap: wrap; gap: 0 8px; }
  .pc__from { font-size: 14px; font-weight: 400; color: var(--steel-deep); letter-spacing: 0; align-self: center; }
  .pc__price small { font-size: 14px; font-weight: 400; color: var(--steel-deep); letter-spacing: 0; }
  .pc__unit { color: var(--steel-deep); }
  .pc__min { display: flex; justify-content: space-between; gap: 12px; margin-top: 22px; padding-top: 16px; border-top: 1px solid var(--alloy); font-size: 15px; }
  /* Long values (paid-trial lease / deposit): label above value so the value gets the full card width. */
  .pc__min--stack { flex-direction: column; gap: 2px; }
  .pc__min span { color: var(--steel-deep); }
  .pc__min b { font-weight: 500; }
  .pc__d { color: var(--steel); font-size: 15px; line-height: 1.6; margin: 16px 0 24px; flex: 1; }
  .pc .btn { align-self: flex-start; }
  /* 4-up: the 'Recommended' flag is a tab on top of the featured card, so every card's name / price / unit /
     divider sit on the same rows. Narrower layouts (<=1240) keep the flag inside the card corner. */
  .pc--feat { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .pc--feat .pc__name, .pc--feat .pc__unit, .pc--feat .pc__min span, .pc--feat .pc__d, .pc--feat .pc__from, .pc--feat .pc__price small { color: var(--mist-lt); }
  .pc--feat .pc__min { border-color: var(--rule-dark); }
  .pc--feat :focus-visible { outline-color: var(--amber); } /* dark card: the default amber-deep ring is ~3:1 on ink */
  .pc__flag { position: absolute; bottom: calc(100% - 1px); right: -1px; display: flex; gap: 8px; align-items: center; background: var(--amber); color: var(--ink); padding: 6px 12px; border-radius: var(--r-1) var(--r-1) 0 0; font-weight: 500; }
  .tiers { margin-top: clamp(56px, 6vw, 88px); }
  .tiers__head { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 12px 32px; align-items: end; margin-bottom: 24px; }
  .tiers__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
  .tiers tfoot th { text-transform: none; letter-spacing: 0; font: 400 15px var(--f-mono); color: var(--steel-deep); border-top: 1px solid var(--ink); border-bottom: 0; padding-top: 13px; }
  .tiers tfoot td { border-top: 1px solid var(--ink); border-bottom: 0; }
  .tiers tfoot b { font-weight: 500; }
  .tiers__note { margin-top: 20px; max-width: 52em; font-size: 16px; }
  .tiers__callout { margin-top: 10px; color: var(--steel-deep); }
  .ex { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 20px 32px; margin-top: clamp(56px, 6vw, 88px); align-items: start; }
  .ex__body { padding: 16px 22px 20px; font-size: 15px; }
  .ex__line { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0 16px; line-height: 2; }
  .ex__total { border-top: 1px solid var(--alloy); margin-top: 8px; padding-top: 8px; font-size: 17px; font-weight: 500; }
  .ex__note { margin-top: 12px; color: var(--steel-deep); font-size: 14px; line-height: 1.6; }
  .ex__intro { margin: 10px 0 18px; font-size: 16px; }
  .extras { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; margin-top: clamp(56px, 6vw, 88px); align-items: start; }
  .plate__foot { padding: 14px 18px 18px; border-top: 1px solid var(--alloy); font-size: 15px; }
  /* Extras plates: label above value, so a price never breaks mid-figure ("+€200–/500…"). */
  .extras .plate dl { grid-template-columns: minmax(0, 1fr); }
  .extras .plate dt { padding-bottom: 2px; }
  .extras .plate dd { border-top: 0; padding-top: 2px; }
  .extras .plate dl > :nth-child(2) { border-top: 0; }
  .incl { padding: 6px 18px 14px; }
  .incl li { position: relative; padding: 9px 0 9px 20px; border-bottom: 1px solid var(--alloy); font-size: 15px; }
  .incl li:last-child { border-bottom: 0; }
  .incl li::before { content: ""; position: absolute; left: 0; top: 1.05em; width: 9px; height: 6.5px; border-radius: 50%; background: var(--ink); }
  .terms { margin-top: 48px; border-top: 1px solid var(--ink); padding-top: 22px; display: grid; gap: 12px; }
  .terms__k { display: inline-block; margin-right: 14px; color: var(--steel); }
  .terms__fine { font-size: 15px; max-width: 64em; }
  .terms__eu { color: var(--steel-deep); }
  @media (max-width: 1240px) {
    .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); margin-top: 32px; }
    .pc--feat, .pc--feat + .pc { padding-top: 52px; }
    .pc__flag { top: -1px; bottom: auto; border-radius: 0 var(--r-2) 0 var(--r-1); }
  }
  /* Plan cards: 4-up > 1240, 2-up 700–1240, one column that fills the container below 700. */
  @media (max-width: 1000px) { .extras { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 699px) { .cards { grid-template-columns: minmax(0, 1fr); } .pc--feat + .pc { padding-top: 28px; } }
  /* Two rate tables / the examples table need ~560 / ~720 px each; below 1240 px they take the full row. */
  @media (max-width: 1240px) { .tiers__grid, .ex { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 860px) { .tiers__head { grid-template-columns: minmax(0, 1fr); } }
  /* Rate and example tables stack as cards below 720 px (global .tbl--stack), so nothing is clipped at 390 px in either locale. */
  @media (max-width: 900px) {
    .tbl caption { padding: 14px 16px; }
    .tbl caption .mono { display: block; margin-top: 4px; }
    .tiers tfoot th, .tiers tfoot td { border-top: 0; }
    .tiers tfoot tr { border-top: 1px solid var(--ink); }
    .tiers tfoot th { padding-top: 0; font-size: 15px; }
    .tbl--stack tbody td.r { font-size: 16px; }
  }
  /* Money never breaks mid-amount at 390 px: rate/total cells and the worked-example totals stay on one line. */
  .tbl td.r, .ex__line span:last-child { white-space: nowrap; }
</style>
