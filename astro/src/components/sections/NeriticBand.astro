---
// Brief Neritic AI band under the Home hero strip. Rendered by HomePage only when features.neriticAi is true.
// One headline, one line, one link. HurricaneOS stays the headline product: this band uses h3-size type on a plain plate.
// The link to neritic.ai is shown only when showNeriticLink is true (both switches on), so the band can run before the domain is live.
import Arrow from '../Arrow.astro';
import { showNeriticLink } from '../../data/features';
import { neritic } from '../../data/neritic';
import type { Locale } from '../../i18n/ui';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const n = neritic[locale];
---
<section class="nb wrap" aria-labelledby="nb-h">
  <div class="nb__plate plate">
    <div class="nb__id">
      <p class="legend nb__name">{n.name}</p>
      <h2 id="nb-h" class="h3 nb__h">{n.headline}</h2>
    </div>
    <p class="nb__line">{n.line}</p>
    {showNeriticLink && (
      <a class="link-arrow nb__link" href={n.linkHref} rel="noopener">{n.linkLabel}<Arrow dir="up-right" /></a>
    )}
  </div>
</section>
<style>
  .nb { padding-top: 40px; }
  .nb__plate { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 4fr) auto; align-items: center; gap: 16px 40px; padding: 26px 32px; }
  .nb__name { color: var(--steel-deep); }
  .nb__h { margin-top: 6px; }
  .nb__line { color: var(--steel); font-size: 16px; }
  .nb__link { justify-self: end; white-space: nowrap; }
  @media (max-width: 960px) {
    .nb__plate { grid-template-columns: minmax(0, 1fr) auto; }
    .nb__line { grid-column: 1; }
    .nb__link { grid-column: 2; grid-row: 1 / span 2; align-self: center; }
  }
  @media (max-width: 600px) {
    .nb { padding-top: 32px; }
    .nb__plate { grid-template-columns: minmax(0, 1fr); padding: 22px 20px; }
    .nb__link { grid-column: 1; grid-row: auto; justify-self: start; }
  }
</style>
