---
import ArrowText from '../ArrowText.astro';
import Layout from '../../layouts/Layout.astro';
import { getEntry, render } from 'astro:content';
import { localizePath, type Locale } from '../../i18n/ui';
import { site } from '../../data/site';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const entry = await getEntry(locale, 'legal');
if (!entry) throw new Error(`legal.md missing for ${locale}`);
const { Content } = await render(entry);
const s = site[locale];
---
<Layout title={s.meta.legal.title} description={s.meta.legal.desc} locale={locale} path="/legal">
  <article class="wrap legal">
    <p class="mono back"><a href={localizePath('/', locale)}><ArrowText text={s.legal.back} /></a></p>
    <div class="md"><Content /></div>
  </article>
</Layout>
<style>
  .legal { padding-block: 56px var(--band-y); }
  .back a { display: inline-flex; align-items: center; gap: 8px; color: var(--steel); }
  .md { max-width: 46em; margin-top: 28px; }
  .md :global(h1) { font-family: var(--f-display); font-stretch: 118%; font-weight: 640; font-size: clamp(34px, 1.6rem + 2vw, 56px); line-height: 1.05; margin-bottom: 18px; }
  .md :global(h2) { font-family: var(--f-display); font-stretch: 114%; font-weight: 630; font-size: 26px; margin: 44px 0 12px; padding-top: 22px; border-top: 1px solid var(--alloy); }
  .md :global(h3) { font-family: var(--f-display); font-stretch: 110%; font-weight: 620; font-size: 19px; margin: 28px 0 8px; }
  .md :global(p), .md :global(li) { color: var(--steel); }
  .md :global(p + p) { margin-top: 1em; }
  .md :global(ul), .md :global(ol) { padding-left: 1.2em; margin: 0.8em 0; }
  .md :global(strong) { color: var(--ink); }
  .md :global(table) { width: 100%; border-collapse: collapse; margin: 1em 0; font-size: 14px; display: block; overflow-x: auto; }
  .md :global(th), .md :global(td) { text-align: left; padding: 10px 12px; border-bottom: 1px solid var(--alloy); vertical-align: top; }
  .md :global(a) { color: var(--ink); }
</style>
