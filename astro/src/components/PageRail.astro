---
// Page rail: the "where am I / what is on this page" control for long pages (Platform, Pricing, Compliance).
// One component, two layouts, one behaviour:
//   layout="bar"  — a slim sticky strip under the nav (full-bleed bands: Platform, Pricing);
//   layout="side" — the vertical sticky column beside a narrow body (Compliance).
// Below its breakpoint both collapse to the same compact control: a 48 px sticky bar showing "On this page" + the
// section you are in; it opens a list. The current section carries aria-current="location" and a lit amber lamp;
// a hairline at the bottom of the bar fills with scroll progress. The last item is always "Book a demo".
// No JS: the list simply shows as a normal in-flow list (the `js` class gates every collapsed state).
import Arrow from './Arrow.astro';
import { localizePath, type Locale } from '../i18n/ui';
interface Item { id: string; label: string; }
interface Props {
  locale: Locale;
  items: Item[];
  /** Label of the final "Book a demo" item (the existing hero CTA string). */
  cta: string;
  layout?: 'bar' | 'side';
  /** Optional small line above the list (side layout), e.g. "Last reviewed". */
  note?: string;
}
const { locale, items, cta, layout = 'bar', note } = Astro.props;
const label = locale === 'pl' ? 'Na tej stronie' : 'On this page';
const contact = localizePath('/company', locale) + '#contact';
const uid = 'rail-list';
---
<div class={`rail rail--${layout}`} data-rail>
  <div class="rail__in wrap">
    <nav class="rail__nav" aria-label={label}>
      <button class="rail__toggle" type="button" aria-expanded="false" aria-controls={uid}>
        <span class="rail__k legend">{label}</span>
        <span class="rail__cur" data-cur></span>
        <span class="rail__chev" aria-hidden="true"></span>
      </button>
      <div class="rail__panel" id={uid}>
        {note && <p class="mono rail__note">{note}</p>}
        <ol role="list" class="rail__list">
          {items.map((it) => <li><a href={`#${it.id}`} data-sec={it.id}>{it.label}</a></li>)}
          <li class="rail__book"><a class="btn btn--ghost btn--sm" href={contact}>{cta}<Arrow /></a></li>
        </ol>
      </div>
    </nav>
  </div>
  <span class="rail__prog" aria-hidden="true"></span>
</div>

<style is:global>
  /* ---------- shared item style ---------- */
  .rail__list { display: flex; align-items: stretch; margin: 0; padding: 0; list-style: none; }
  .rail__list a:not(.btn) { position: relative; display: flex; align-items: center; gap: 9px; text-decoration: none; color: var(--steel); font: 500 14px/1.3 var(--f-body); }
  .rail__list a:not(.btn):hover { color: var(--ink); }
  /* The lit lamp = "you are here". Space for it is always reserved (opacity, not display) so nothing shifts. */
  .rail__list a:not(.btn)::before { content: ""; flex: none; width: 7px; height: 5px; border-radius: 50%; background: var(--amber); opacity: 0; }
  .rail__list a[aria-current='location'] { color: var(--ink); font-weight: 650; }
  .rail__list a[aria-current='location']::before { opacity: 1; }
  .rail__toggle { display: none; }
  .rail__prog { display: none; position: absolute; left: var(--gut); right: var(--gut); bottom: 0; height: 2px; background: var(--amber); transform-origin: 0 50%; transform: scaleX(var(--p, 0)); pointer-events: none; }

  /* ---------- bar layout ---------- */
  .rail--bar { position: sticky; top: var(--nav-h); z-index: 40; background: color-mix(in srgb, var(--paper) 97%, transparent); backdrop-filter: saturate(1.2) blur(10px); -webkit-backdrop-filter: saturate(1.2) blur(10px); }
  .rail--bar::after { content: ""; position: absolute; left: var(--gut); right: var(--gut); bottom: 0; height: 1px; background: var(--alloy); }
  .rail--bar .rail__in { height: 48px; }
  .rail--bar .rail__nav, .rail--bar .rail__panel { height: 100%; }
  /* The reserved lamp slot (16 px) hangs into the gutter so the first label lines up with the page content edge. */
  .rail--bar .rail__list { height: 100%; gap: clamp(14px, 1.9vw, 30px); margin-left: -16px; }
  .rail--bar .rail__list a:not(.btn) { height: 100%; white-space: nowrap; }
  .rail--bar .rail__book { margin-left: auto; display: flex; align-items: center; }
  .rail--bar .rail__book .btn { min-height: 34px; padding: 0 14px; font-size: 13px; }

  /* ---------- side layout (Compliance) ---------- */
  .rail--side { position: sticky; top: calc(var(--nav-h) + 24px); z-index: 1; border-top: 1px solid var(--ink); padding-top: 16px; }
  .rail--side .rail__in { padding-inline: 0; max-width: none; }
  .rail--side .rail__note { color: var(--steel-deep); margin-bottom: 16px; }
  .rail--side .rail__list { flex-direction: column; }
  .rail--side .rail__list a:not(.btn) { padding: 9px 0; border-bottom: 1px solid var(--alloy); font-weight: 450; line-height: 1.35; }
  .rail--side .rail__list a[aria-current='location'] { font-weight: 650; border-bottom-color: var(--ink); }
  .rail--side .rail__book { margin-top: 20px; }

  /* ---------- compact control (bar < 1180 px, side <= 1040 px) ---------- */
  @media (max-width: 1179px) {
    .rail--bar .rail__toggle { display: flex; }
    .rail--bar .rail__prog { display: block; }
  }
  @media (max-width: 1040px) {
    .rail--side { position: sticky; top: var(--nav-h); z-index: 40; margin-inline: calc(var(--gut) * -1); padding: 0; border-top: 0; background: color-mix(in srgb, var(--paper) 97%, transparent); backdrop-filter: saturate(1.2) blur(10px); -webkit-backdrop-filter: saturate(1.2) blur(10px); }
    .rail--side .rail__in { padding-inline: var(--gut); max-width: none; }
    .rail--side::after { content: ""; position: absolute; left: var(--gut); right: var(--gut); bottom: 0; height: 1px; background: var(--alloy); }
    .rail--side .rail__prog { display: block; }
    .rail--side .rail__toggle { display: flex; }
  }
  /* shared compact behaviour (selectors written once per layout above; the rules below apply to both) */
  @media (max-width: 1179px) {
    .rail--bar .rail__toggle { width: 100%; min-height: 48px; align-items: center; gap: 12px; padding: 0; border: 0; background: none; cursor: pointer; text-align: left; }
    .rail--bar .rail__k { flex: none; color: var(--steel-deep); }
    .rail--bar .rail__cur { flex: 1 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font: 650 14px/1.3 var(--f-body); color: var(--ink); text-align: right; }
    .rail--bar .rail__cur:empty { display: none; }
    .rail--bar .rail__chev { flex: none; width: 8px; height: 8px; margin: -3px 2px 0 0; border: solid var(--ink); border-width: 0 1.75px 1.75px 0; transform: rotate(45deg); }
    .rail--bar .rail__toggle[aria-expanded='true'] .rail__chev { transform: rotate(-135deg); margin-top: 3px; }
    .js .rail--bar .rail__panel { display: none; position: absolute; left: 0; right: 0; top: 100%; height: auto; max-height: calc(100vh - var(--nav-h) - 48px - 12px); overflow-y: auto; background: var(--paper); border-bottom: 1px solid var(--alloy); box-shadow: 0 24px 40px -28px rgba(13, 15, 18, 0.55); padding: 6px var(--gut) 20px; }
    .js .rail--bar.is-open .rail__panel { display: block; }
    .rail--bar .rail__list { flex-direction: column; height: auto; gap: 0; margin-left: 0; }
    .rail--bar .rail__list a:not(.btn) { height: auto; min-height: 48px; padding: 8px 0; border-bottom: 1px solid var(--alloy); white-space: normal; }
    .rail--bar .rail__book { margin: 18px 0 0; display: block; }
    .rail--bar .rail__book .btn { width: 100%; min-height: 48px; background: var(--amber); border-color: var(--amber); color: var(--ink); font-size: 15px; }
    /* Panel stays as an in-flow list without JS. */
    html:not(.js) .rail--bar { position: static; }
    html:not(.js) .rail--bar .rail__toggle { display: none; }
    html:not(.js) .rail--bar .rail__in { height: auto; padding-block: 12px; }
    html:not(.js) .rail--bar .rail__panel { position: static; box-shadow: none; padding: 0; }
  }
  @media (max-width: 1040px) {
    .rail--side .rail__toggle { width: 100%; min-height: 48px; align-items: center; gap: 12px; padding: 0; border: 0; background: none; cursor: pointer; text-align: left; }
    .rail--side .rail__k { flex: none; color: var(--steel-deep); }
    .rail--side .rail__cur { flex: 1 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font: 650 14px/1.3 var(--f-body); color: var(--ink); text-align: right; }
    .rail--side .rail__cur:empty { display: none; }
    .rail--side .rail__chev { flex: none; width: 8px; height: 8px; margin: -3px 2px 0 0; border: solid var(--ink); border-width: 0 1.75px 1.75px 0; transform: rotate(45deg); }
    .rail--side .rail__toggle[aria-expanded='true'] .rail__chev { transform: rotate(-135deg); margin-top: 3px; }
    .js .rail--side .rail__panel { display: none; position: absolute; left: 0; right: 0; top: 100%; max-height: calc(100vh - var(--nav-h) - 48px - 12px); overflow-y: auto; background: var(--paper); border-bottom: 1px solid var(--alloy); box-shadow: 0 24px 40px -28px rgba(13, 15, 18, 0.55); padding: 10px var(--gut) 20px; }
    .js .rail--side.is-open .rail__panel { display: block; }
    .rail--side .rail__note { margin-bottom: 8px; }
    .rail--side .rail__list a:not(.btn) { min-height: 48px; }
    .rail--side .rail__book .btn { width: 100%; min-height: 48px; background: var(--amber); border-color: var(--amber); color: var(--ink); font-size: 15px; }
    html:not(.js) .rail--side { position: static; margin-inline: 0; }
    html:not(.js) .rail--side .rail__toggle { display: none; }
    html:not(.js) .rail--side .rail__panel { position: static; box-shadow: none; padding: 0; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .rail__prog { transition: transform 120ms linear; }
    .rail__list a:not(.btn)::before { transition: opacity var(--dur) var(--ease); }
  }
</style>

<script is:inline>
  (function () {
    var rail = document.querySelector('[data-rail]');
    if (!rail || rail.__init) return;
    rail.__init = true;
    var links = Array.prototype.slice.call(rail.querySelectorAll('a[data-sec]'));
    // Sections come after this element in the DOM, so they are looked up on every update (not at parse time).
    function sec(a) { return document.getElementById(a.getAttribute('data-sec')); }
    var toggle = rail.querySelector('.rail__toggle');
    var cur = rail.querySelector('[data-cur]');
    var nav = document.querySelector('.nav');
    var active = -1, ticking = false;

    function isCompact() { return toggle && getComputedStyle(toggle).display !== 'none'; }
    function setOpen(open) {
      if (!toggle) return;
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      rail.classList.toggle('is-open', open);
    }
    function mark(i) {
      if (i === active) return;
      active = i;
      links.forEach(function (a, k) { if (k === i) a.setAttribute('aria-current', 'location'); else a.removeAttribute('aria-current'); });
      if (cur) cur.textContent = i >= 0 ? links[i].textContent : '';
    }
    function update() {
      ticking = false;
      var navH = nav ? nav.getBoundingClientRect().height : 0;
      // The reading line: just under the nav (+ the rail when it is a strip). A section is "current" once its top has crossed it.
      var line = navH + (rail.classList.contains('rail--bar') || isCompact() ? rail.getBoundingClientRect().height : 0) + Math.min(260, window.innerHeight * 0.3);
      var idx = -1;
      for (var i = 0; i < links.length; i++) { var el = sec(links[i]); if (el && el.getBoundingClientRect().top <= line) idx = i; }
      mark(idx);
      var max = document.documentElement.scrollHeight - window.innerHeight;
      rail.style.setProperty('--p', max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)).toFixed(4) : 0);
    }
    function req() { if (!ticking) { ticking = true; window.requestAnimationFrame(update); } }

    if (toggle) {
      toggle.addEventListener('click', function () { setOpen(toggle.getAttribute('aria-expanded') !== 'true'); });
      rail.addEventListener('click', function (e) { if (e.target.closest && e.target.closest('a') && isCompact()) setOpen(false); });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') { setOpen(false); toggle.focus(); }
      });
      document.addEventListener('click', function (e) { if (!rail.contains(e.target)) setOpen(false); });
      rail.addEventListener('focusout', function (e) { if (e.relatedTarget && !rail.contains(e.relatedTarget)) setOpen(false); });
      window.addEventListener('resize', function () { if (!isCompact()) setOpen(false); });
    }
    window.addEventListener('scroll', req, { passive: true });
    window.addEventListener('resize', req);
    window.addEventListener('hashchange', req);
    window.addEventListener('load', req);
    update();
  })();
</script>
